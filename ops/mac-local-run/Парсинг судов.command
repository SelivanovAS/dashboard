#!/bin/bash
# ═════════════════════════════════════════════════════════════════════════════
# «Парсинг судов» — живой просмотр хода парсинга. Двойной клик — и всё.
#
# Показывает ТЕКУЩИЙ (или последний завершённый) прогон с самого начала и
# продолжает выводить новые строки по мере парсинга. Прокрутка вверх — история
# прошлых прогонов. Закрыть окно (⌘W) — просто закрыть просмотр, на сам
# парсинг это никак не влияет.
# ═════════════════════════════════════════════════════════════════════════════
LOG="/Users/aleksandrselivanov/dashboard/ops/mac-local-run/parse_and_push.log"

clear
echo "══════════════════════ МОНИТОРИНГ СУДОВ СБЕРБАНКА ══════════════════════"
if [ ! -f "$LOG" ]; then
  echo "Лог ещё не создавался — парсинг ни разу не запускался на этом Mac."
  echo "Нажмите любую клавишу, чтобы закрыть."
  read -n 1 -s
  exit 0
fi

if pgrep -f run_parse.py >/dev/null 2>&1; then
  echo "⏳  ПАРСИНГ ИДЁТ ПРЯМО СЕЙЧАС — строки бегут ниже."
else
  echo "💤  Сейчас парсинг не идёт — показан последний прогон."
  echo "    Окно можно оставить открытым: следующий прогон появится здесь же."
fi
echo "    Прокрутка вверх — история. Закрыть просмотр: ⌘W (парсинг не трогает)."
echo "═════════════════════════════════════════════════════════════════════════"

# Начало последнего прогона: последняя строка-маркер «Старт» в логе.
start=$(grep -n "Старт" "$LOG" 2>/dev/null | tail -1 | cut -d: -f1)
exec tail -n "+${start:-1}" -f "$LOG"
