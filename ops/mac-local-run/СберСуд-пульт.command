#!/bin/bash
# ═════════════════════════════════════════════════════════════════════════════
# «СберСуд · пульт» — двойной клик, и всё управление резервом в одном окне.
#
# Для юриста, не для программиста: запустить парсинг или подбор дампов руками,
# посмотреть живой ход, проверить готовность. Ничего не настраивает и не
# ломает: под капотом те же скрипты, что зовут агенты по расписанию.
#
# Все действия идут с --anywhere: в офисе это ничего не меняет (сеть Сбера
# распознаётся сама), а из дома работает без шлюза — честная проба судов
# решает, есть ли доступ (через корпоративный VPN суды отдают 403 — проба
# это скажет прямо).
# ═════════════════════════════════════════════════════════════════════════════
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/lib_sber_net.sh"
PYTHON="/usr/bin/python3"

repos=()
while IFS= read -r line; do
  repos+=("$line")
done < <(cm_territories)

# Живой вывод парсинга: parse_and_push пишет только в лог-файлы — на время
# работы поднимаем tail по логам всех территорий и гасим его по завершении.
tail_logs() {  # $1 = имя лог-файла (parse_and_push.log / import_dumps.log)
  local files=()
  local r
  for r in "${repos[@]}"; do
    [ -f "$r/ops/mac-local-run/$1" ] || touch "$r/ops/mac-local-run/$1" 2>/dev/null
    files+=("$r/ops/mac-local-run/$1")
  done
  tail -n 0 -f "${files[@]}" 2>/dev/null &
  TAIL_PID=$!
}
stop_tail() {
  [ -n "${TAIL_PID:-}" ] && kill "$TAIL_PID" 2>/dev/null
  TAIL_PID=""
}
trap 'stop_tail' EXIT

cloud_status() {
  local r
  for r in "${repos[@]}"; do
    ( cd "$r" 2>/dev/null && "$PYTHON" ops/mac-local-run/cloud_run_ok.py --report 2>/dev/null ) \
      || echo "$(basename "$r"): статус не прочитался"
  done
}

pause() { echo; read -r -p "Enter — назад в меню… " _; }

while :; do
  # clear только в настоящем терминале: без TERM (запуск из скрипта/теста)
  # он лишь печатает предупреждение.
  [ -t 1 ] && [ -n "${TERM:-}" ] && clear
  echo "══════════════════════════ СберСуд · пульт резерва ══════════════════════════"
  echo "Сегодня: $(date '+%a %d.%m %H:%M') · территорий: ${#repos[@]}"
  echo
  echo "Облако сегодня (по журналу здоровья парсеров):"
  cloud_status | sed 's/^/  /'
  echo
  echo "  [1] Запустить парсинг сейчас (обе территории, мимо гейта)"
  echo "  [2] Подобрать дампы сейчас (только потерянное облаком)"
  echo "  [3] Смотреть живой лог (что идёт прямо сейчас)"
  echo "  [4] Проверка: сеть · суды · настройки"
  echo "  [0] Выход"
  echo
  read -r -p "Выберите: " choice
  case "${choice:-}" in
    1)
      echo
      echo "Парсинг обеих территорий. Это 15–40 минут; строки бегут ниже."
      echo "Прервать — ⌘. (Command-точка); уже сделанное не потеряется."
      echo "──────────────────────────────────────────────────────────────"
      tail_logs parse_and_push.log
      bash "$HERE/parse_all.sh" --force --anywhere
      stop_tail
      echo "──────────────────────────────────────────────────────────────"
      echo "Готово. Если были изменения — дайджест соберёт и разошлёт GitHub."
      pause
      ;;
    2)
      echo
      echo "Подбор дампов: берутся только те, что облако не довело или довело"
      echo "с потерями. Повтор безопасен — дубликатов не будет."
      echo "──────────────────────────────────────────────────────────────"
      bash "$HERE/import_all.sh" --anywhere
      echo "──────────────────────────────────────────────────────────────"
      pause
      ;;
    3)
      echo
      echo "Живой лог парсинга и импорта по всем территориям."
      echo "Выход из просмотра — ⌘. (Command-точка) или закрыть окно ⌘W."
      echo "──────────────────────────────────────────────────────────────"
      files=()
      for r in "${repos[@]}"; do
        for f in parse_and_push.log import_dumps.log; do
          [ -f "$r/ops/mac-local-run/$f" ] && files+=("$r/ops/mac-local-run/$f")
        done
      done
      if [ ${#files[@]} -eq 0 ]; then
        echo "Логов ещё нет — ни парсинг, ни импорт не запускались."
      else
        tail -n 20 -f "${files[@]}"
      fi
      pause
      ;;
    4)
      echo
      echo "Проверка парсинга:"
      echo "──────────────────────────────────────────────────────────────"
      bash "$HERE/parse_all.sh" --check --anywhere
      echo
      echo "Проверка импорта дампов:"
      echo "──────────────────────────────────────────────────────────────"
      bash "$HERE/import_all.sh" --check --anywhere
      pause
      ;;
    0|q|Q|"")
      echo "До встречи."
      exit 0
      ;;
    *)
      echo "Не понял: «$choice». Введите 1, 2, 3, 4 или 0."
      sleep 1
      ;;
  esac
done
