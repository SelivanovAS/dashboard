<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent: парсинг судов на Mac по будням.
  Ставится в ~/Library/LaunchAgents/ (см. ops/mac-local-run/README.md).
  Зовёт parse_all.sh — он прогоняет ВСЕ территории подряд (список клонов
  в ~/.config/court-monitor/territories; нет файла = только ~/dashboard).

  Время — ЛОКАЛЬНОЕ (этот Mac на +05). LaunchAgent досрабатывает при
  пробуждении/входе, если в назначенный час Mac спал или ты не был
  залогинен. Поменять время — Hour/Minute ниже. Weekday: 1=Пн … 5=Пт.

  ⚠️ 09:00 и 11:00, а НЕ 08:00 — агент работает ВТОРЫМ СЛОЕМ, после облака.
  Крон Cloudflare ходит в 03:00 UTC (Урал) и 03:30 UTC (ХМАО) = 08:00 и
  08:30 местного, прогон занимает ~15-30 минут. Запускаться с ними в один час
  нельзя: две машины сделали бы одну работу и обе запушили, а у Mac-коммита
  маркер «(Mac-парсинг)», по которому replay_on_push рассылает дайджест, —
  юрист и коллеги получили бы его дважды. Гейт в parse_and_push.sh
  (cloud_run_ok.py по журналу здоровья) выпускает Mac ТОЛЬКО когда облачный
  прогон был слепым (адрес раннера заблокирован — все источники по нулям)
  или не состоялся; при зрячем облаке агент выходит за секунды без коммита.

  Второй слот 11:00 — страховка «Mac спал в 09:00» (18.08.2026: агент не
  сработал ни разу за день, runs = 0 — машина спала в момент слота, и
  launchd пропуск не догнал). При удачном 09:00 или зрячем облаке гейт
  превращает 11:00 в тихий «пропуск».
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.court-monitor.parse</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aleksandrselivanov/dashboard/ops/mac-local-run/parse_all.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/aleksandrselivanov/dashboard/ops/mac-local-run/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aleksandrselivanov/dashboard/ops/mac-local-run/launchd.err.log</string>
</dict>
</plist>
