<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent: разбор очереди дампов капчёвых судов на Mac.
  Ставится в ~/Library/LaunchAgents/ (см. ops/mac-local-run/README.md).
  Зовёт import_all.sh — тот прогоняет import_dumps.sh по всем территориям.

  Расписание — решение юриста 18.08.2026: будни 10:30, 12:30, 14:30, 16:30,
  18:30 (местное время Mac). Оператор кормит дампы с утра до вечера, а облако
  часть теряет (суды режут кусок адресного пула раннеров) — каждые два часа
  Mac подбирает потерянное. Пустая очередь = выход за секунды; вне сети Сбера
  скрипт тихо пропускает. Парсингом занимается СОСЕДНИЙ агент
  (com.court-monitor.parse) — у них общий лок на клон, пересечение безопасно.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.court-monitor.import</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aleksandrselivanov/dashboard/ops/mac-local-run/import_all.sh</string>
    </array>

