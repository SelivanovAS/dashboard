# =============================================================================
# Что резерв на Mac забирает из журнала импортов Worker'а.
#
# Каналов ДВА (с 23.08.2026): дампы выдачи капчёвых судов (import:dump:) и
# точечные пачки из админки (import:case:). Оба теряют дела по одной причине —
# суд не отдал карточку, — и оба лечатся повтором с машины в сети Сбера.
#
# Вход  — ответ GET /admin/import-log (объект с .items[]).
# Выход — TSV «kind, uuid, домен, оператор, прежний статус», по строке на запись.
# Аргументы: --argjson now <epoch> --argjson ttl <сек>
#            --argjson grace <сек: живой облачный ДАМП>
#            --argjson cgrace <сек: живая облачная ПАЧКА>
#
# ОБЩИЕ ПРАВИЛА:
#   * Старше TTL KV (24 ч) — тела в KV уже нет, забирать нечего; оператору надо
#     отправить заново.
#   * Локальной памяти «уже сделано» НЕТ намеренно: успешный отчёт резерва
#     обнуляет счётчики потерь, и следующий заход запись просто не выберет.
#
# ДАМПЫ (kind отсутствует):
#   * Берём, если облако НЕ довело (status != done) ЛИБО довело с потерями:
#     fetch_fail — иск банка не заведён вовсе, card_failed — дело заведено
#     пустышкой.
#   * Запись «идёт» моложе grace (15 мин при timeout-minutes: 15 у
#     import_cases.yml) не трогаем: облачный джоб, скорее всего, ещё жив, и два
#     отчёта затёрли бы друг друга.
#
# ПАЧКИ (kind:"case"):
#   * Признак потери свой — fetch_error: в ссылочном режиме (единственный путь
#     для капчёвых судов) роль банка решается только по карточке, и без неё
#     строка выбрасывается ЦЕЛИКОМ — card-blind записи, как у дампов, там не
#     выходит.
#   * ⚠️ Свой грейс cgrace (50 мин), а НЕ дамповые 15: у add_cases.yml
#     timeout-minutes: 45, и пачка из 20 номеров честно идёт полчаса. С
#     дамповым грейсом Mac полез бы писать в те же файлы посреди живого
#     облачного джоба.
#   * ⚠️ Статус "dispatched" под грейсом обязателен отдельной веткой: у
#     GitHub-группы cases-data-write живёт один pending, и запись может
#     простоять в этом статусе всё время очереди — «моложе 50 мин» тут значит
#     «облако ещё может за неё взяться».
#   * "failed" берём сразу: статус терминальный, гонки нет.
#
# ПОМЕТКИ «лист не нужен» (kind:"writ_waiver") НЕ берём никогда: пультовая
# операция к судам не ходит, дочитывать в ней нечего.
#
# Отдельным файлом — чтобы правила проверялись тестом
# (scripts/tests/test_mac_import_dumps.py), а не только глазами.
# =============================================================================
def epoch: try (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) catch 0;
# ⚠️ Пустое поле в TSV читать нечем: `IFS=$'\t' read` схлопывает подряд идущие
# табы (таб — это IFS-пробел), и одно пустое значение сдвигает ВСЕ следующие.
# У дампов это уже врало: оператор без имени отдавал строку, где в его поле
# оказывался статус. Пишем прочерк, шелл возвращает его в пустоту.
def dash: if ((. // "") | tostring) == "" then "-" else . end;

.items[]
| . as $r
| (($r.kind // "dump")) as $kind
| select($kind == "dump" or $kind == "case")
| select($r.uuid != null)
| (($r.ts // "") | epoch) as $born
| ((($r.updated_at // $r.ts) // "") | epoch) as $seen
| select($born > ($now - $ttl))
| select(
    if $kind == "case" then
      (($r.status == "done") and (($r.fetch_error // 0) > 0))
      or ($r.status == "failed")
      or ((($r.status == "dispatched") or ($r.status == "started"))
          and ($seen < ($now - $cgrace)))
    else
      # Домен у дампа обязателен: без него импортёру нечего передать в --court.
      ($r.court_domain != null)
      and (($r.status != "done")
           or (($r.fetch_fail // 0) > 0) or (($r.card_failed // 0) > 0))
      and (($r.status != "started") or ($seen < ($now - $grace)))
    end
  )
| [$kind, $r.uuid, ($r.court_domain | dash), ($r.operator | dash), ($r.status // "?")]
| @tsv
