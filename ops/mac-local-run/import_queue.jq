# =============================================================================
# Какие дампы резерв на Mac забирает из журнала импортов Worker'а.
#
# Вход  — ответ GET /admin/import-log (объект с .items[]).
# Выход — TSV «uuid, домен, оператор, прежний статус», по строке на дамп.
# Аргументы: --argjson now <epoch> --argjson ttl <сек> --argjson grace <сек>
#
# ПРАВИЛА (каждое закрывает свой способ навредить):
#   1. kind:"case" — точечное добавление дел, другой канал и другой скрипт.
#   2. Старше TTL KV (24 ч) — дампа в KV уже нет, забирать нечего; оператору
#      надо вставить выдачу заново.
#   3. Берём запись, если облако её НЕ довело (status != done) ЛИБО довело с
#      потерями: fetch_fail — иск банка не заведён вовсе, card_failed — дело
#      заведено пустышкой. Успешный отчёт резерва обнуляет оба счётчика,
#      поэтому локальной памяти «уже сделано» не нужно: следующий заход эту
#      запись просто не выберет.
#   4. Запись «идёт» моложе grace (15 мин) не трогаем: облачный джоб, скорее
#      всего, ещё жив, и два отчёта затёрли бы друг друга.
#
# Отдельным файлом — чтобы правила проверялись тестом
# (scripts/tests/test_mac_import_dumps.py), а не только глазами.
# =============================================================================
def epoch: try (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) catch 0;

.items[]
| select((.kind // "dump") != "case")
| select(.uuid != null and .court_domain != null)
| . as $r
| (($r.ts // "") | epoch) as $born
| ((($r.updated_at // $r.ts) // "") | epoch) as $seen
| select($born > ($now - $ttl))
| select(($r.status != "done")
         or (($r.fetch_fail // 0) > 0) or (($r.card_failed // 0) > 0))
| select(($r.status != "started") or ($seen < ($now - $grace)))
| [$r.uuid, $r.court_domain, ($r.operator // ""), ($r.status // "?")]
| @tsv
