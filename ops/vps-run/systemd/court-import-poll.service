# Немедленная попытка операторского импорта: опрос флага «есть новое»
# (09.09.2026). Слоты — court-import.service, это только быстрый старт.
[Unit]
Description=Court Monitor: опрос флага «есть новое» (немедленный импорт)
After=network-online.target
Wants=network-online.target
# После обычного импорта поллер сам запросит доставку. Этот путь страхует
# аварийное завершение: пустые успешные тики доставку не запускают.
OnFailure=court-delivery.service

[Service]
Type=oneshot
User=root
SyslogIdentifier=court-import-poll
ExecStart=/bin/bash /opt/court-monitor/dashboard/ops/vps-run/import_poll.sh
