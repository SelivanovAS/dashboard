# Дневная очередь операторских импортов (дампы + точечные пачки).
[Unit]
Description=Court Monitor: очередь импортов (слот)
After=network-online.target
Wants=network-online.target
# Длинная очередь могла держать lock до конца утреннего окна доставки.
OnSuccess=court-delivery.service
OnFailure=court-delivery.service

[Service]
Type=oneshot
User=root
SyslogIdentifier=court-import
ExecStart=/bin/bash /opt/court-monitor/dashboard/ops/vps-run/import_all.sh
