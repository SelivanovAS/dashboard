# Страховочные слоты ежедневно 12:00–20:00 ежечасно, включая выходные
# и праздники, время Asia/Yekaterinburg (решение владельца 22.09.2026).
# Новые задания берёт круглосуточный court-import-poll.timer.
# Резерв на Mac сохраняет собственное расписание.
# ⚠️ Тот же список — IMPORT_SLOTS_LOCAL в cloudflare-worker/wrangler.toml
# (админка обещает оператору слот; страж test_mac_import_dumps.py).
# Утренние импорты после парсинга запускаются отдельной службой через
# OnSuccess/OnFailure court-parse.service.
[Unit]
Description=Court Monitor: слоты очереди импортов

[Timer]
OnCalendar=*-*-* 12:00
OnCalendar=*-*-* 13:00
OnCalendar=*-*-* 14:00
OnCalendar=*-*-* 15:00
OnCalendar=*-*-* 16:00
OnCalendar=*-*-* 17:00
OnCalendar=*-*-* 18:00
OnCalendar=*-*-* 19:00
OnCalendar=*-*-* 20:00
Persistent=true

[Install]
WantedBy=timers.target
