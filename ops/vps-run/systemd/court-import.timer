# Страховочные слоты ежедневно 12:00–20:00 каждые 2 часа, включая выходные
# и праздники, время Asia/Yekaterinburg (решение владельца 20.09.2026).
# Новые задания берёт круглосуточный court-import-poll.timer.
# Часы совпадают с Mac-резервом; дни на VPS больше не ограничены буднями.
# ⚠️ Тот же список — IMPORT_SLOTS_LOCAL в cloudflare-worker/wrangler.toml
# (админка обещает оператору слот; страж test_mac_import_dumps.py).
# Утренние импорты после парсинга запускаются отдельной службой через
# OnSuccess/OnFailure court-parse.service.
[Unit]
Description=Court Monitor: слоты очереди импортов

[Timer]
OnCalendar=*-*-* 12:00
OnCalendar=*-*-* 14:00
OnCalendar=*-*-* 16:00
OnCalendar=*-*-* 18:00
OnCalendar=*-*-* 20:00
Persistent=true

[Install]
WantedBy=timers.target
