# Только закрытый пилот. Сертификат и listen/IP выбираются при его подготовке.
# Общедоступный server_name пока НЕ подключать и DNS НЕ менять.
server {
    listen 127.0.0.1:18443;
    server_name api-hmao.delosud.ru;
    client_max_body_size 16m;
    access_log off;
    error_log /dev/null crit;
    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host api-hmao.delosud.ru;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Original-URL "";
        proxy_read_timeout 30s;
    }
}
